# File này quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# KHÔNG ignore: app/, utils/, requirements.txt — image cần chúng để chạy.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần trong image chạy production
tests
screenshots
nginx
*.md
*.zip
grade.py

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.log
